#!/usr/bin/env bash
# House lint gate. Copy to scripts/lint.
set -euo pipefail
cd "$(dirname "$0")/.."
case "py" in
  cpp)
    command -v clang-tidy > /dev/null || { echo "lint: clang-tidy missing — CI image provides it"; exit 0; }
    [[ -f build/ci/compile_commands.json ]] || { echo "lint: configure the 'ci' preset first"; exit 1; }
    clang-tidy -p build/ci $(find src -name '*.cpp') ;;
  py)
    ruff check . && python3 -m mypy --strict src/cradle ;;
esac
