#!/usr/bin/env bash
# House test entry point (Python). Prefers pytest; falls back to stdlib
# unittest discovery in sandboxes without pytest. Copy to scripts/test.
#
# --agent (default): capture the run and print only a summary once it
# finishes -- pass/fail counts, elapsed time, failure tracebacks -- for
# dispatched sessions paying per token to read the result.
# --human: stream the full run live, unchanged from this script's original
# behaviour.
set -euo pipefail
cd "$(dirname "$0")/.."

if [ -x .venv/bin/python3 ]; then
  PYTHON=.venv/bin/python3
else
  PYTHON=python3
fi

mode=agent
saw_agent=0
saw_human=0
junit=0
touched=0
for arg in "$@"; do
  case "$arg" in
    --agent) saw_agent=1; mode=agent ;;
    --human) saw_human=1; mode=human ;;
    --junit) junit=1 ;;
    --touched|--auto-target) touched=1 ;;
    *)
      echo "test: unknown argument: $arg" >&2
      exit 2
      ;;
  esac
done
if [ "$saw_agent" = 1 ] && [ "$saw_human" = 1 ]; then
  echo "test: --agent and --human are mutually exclusive" >&2
  exit 2
fi

target_tests=()
if [ "$touched" = 1 ]; then
  while IFS= read -r line; do
    [ -n "$line" ] && target_tests+=("$line")
  done < <("$PYTHON" -c "
import subprocess
from pathlib import Path

try:
    res = subprocess.run(['git', 'status', '--porcelain'], capture_output=True, text=True, check=True)
    lines = res.stdout.splitlines()
except Exception:
    lines = []

targets = set()
for line in lines:
    if len(line) < 4:
        continue
    path_str = line[3:].strip()
    if ' -> ' in path_str:
        path_str = path_str.split(' -> ')[1].strip()
    if path_str.startswith('\"') and path_str.endswith('\"'):
        path_str = path_str[1:-1]

    p = Path(path_str)
    if p.suffix != '.py':
        continue

    parts = p.parts
    if len(parts) >= 2 and parts[0] == 'src' and parts[1] == 'cradle':
        stem = p.stem
        candidate = Path('tests/unit') / f'test_{stem}.py'
        if candidate.is_file():
            targets.add(str(candidate))
    elif len(parts) >= 2 and parts[0] == 'tests' and parts[1] == 'unit' and p.name.startswith('test_'):
        if p.is_file():
            targets.add(str(p))

for t in sorted(targets):
    print(t)
" 2>/dev/null || true)
fi

# Matches a pytest "-q" per-test progress line (dots/letters + "[NNN%]"),
# the one piece of --agent output that isn't already a summary or a failure.
PROGRESS_LINE_RE='^[[:space:]]*[.FEsxX]+[[:space:]]*\[[[:space:]]*[0-9]{1,3}%\][[:space:]]*$'
# Matches a stdlib unittest "-v" per-test progress line, e.g.
# "test_foo (mod.Case) ... ok" / "... FAIL" / "... ERROR" / "... skipped '…'".
UNITTEST_PROGRESS_LINE_RE='^.*\.\.\.[[:space:]]+(ok|FAIL|ERROR|skipped.*|expected failure|unexpected success)[[:space:]]*$'

if "$PYTHON" -c "import pytest" 2> /dev/null; then
  pytest_args=(-q)
  [ "$junit" = 1 ] && pytest_args+=(--junit-xml=junit.xml)
  if [ "${#target_tests[@]}" -gt 0 ]; then
    pytest_args+=("${target_tests[@]}")
  fi
  if [ "$mode" = human ]; then
    "$PYTHON" -m pytest "${pytest_args[@]}"
  else
    pytest_args+=(--no-header -p no:warnings --color=no)
    set +e
    output=$("$PYTHON" -m pytest "${pytest_args[@]}" 2>&1)
    status=$?
    set -e
    printf '%s\n' "$output" | grep -vE "$PROGRESS_LINE_RE" || true
    exit "$status"
  fi
else
  echo "test: pytest not found — stdlib unittest fallback (write tests unittest-compatible)"
  # start_dir == top_level_dir sidesteps unittest's package-importability
  # check, so no __init__.py is needed; only covers tests/unit (all tests
  # live there today) — a new sibling test dir would need this updated too.
  set +e
  if [ "${#target_tests[@]}" -gt 0 ]; then
    unittest_modules=()
    for t in "${target_tests[@]}"; do
      mod=$(basename "$t" .py)
      unittest_modules+=("$mod")
    done
    output=$(PYTHONPATH=tests/unit "$PYTHON" -m unittest "${unittest_modules[@]}" -v 2>&1)
  else
    output=$("$PYTHON" -m unittest discover -s tests/unit -t tests/unit -v 2>&1)
  fi
  status=$?
  set -e
  if [ "$mode" = human ]; then
    printf '%s\n' "$output"
  else
    printf '%s\n' "$output" | grep -vE "$UNITTEST_PROGRESS_LINE_RE" || true
  fi
  if ! grep -qE "Ran [1-9][0-9]* tests?" <<< "$output"; then
    echo "test: unittest fallback collected zero tests — treating as failure" >&2
    exit 1
  fi
  exit "$status"
fi
